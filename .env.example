# ============================================================================
# ORBIT Health - Environment Variables Configuration
# Copy this file to .env and configure your Supabase Project credentials.
# ============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (From Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: In Expo SDK 58, variables prefixed with EXPO_PUBLIC_ are automatically bundled
# into the client application.
